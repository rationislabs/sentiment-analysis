# Local runs read these from .env (never commit .env).
# A write token for collect/label/push; the hosted dashboard only gets a read token.
HF_TOKEN=
HF_DATASET_REPO=rationislabs/sentiment-headlines
HF_MODEL_REPO=rationislabs/sentiment-models
# Optional read-only token for downloading models; HF_TOKEN is used when empty.
HF_MODEL_TOKEN=
# Set to work on a local folder only; nothing is pulled from or pushed to the Hub.
SENTIMENT_DATA_DIR=
# Set to use local models (e.g. models/) instead of the Hub's.
SENTIMENT_MODEL_DIR=
# 1 shows the Label tab (local only).
LABEL_MODE=
